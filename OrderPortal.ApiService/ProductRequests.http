@hostname = https://localhost
@port = 7532
@baseUrl = {{hostname}}:{{port}}/api/product

### 1. Create Product 1 (POST)
POST {{baseUrl}}
Content-Type: application/json

{
  "id": "1",
  "name": "Mechanical Keyboard",
  "price": 89.99
}

